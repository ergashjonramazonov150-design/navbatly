# Copy this file to .env.local and fill in the values.
# Only PUBLIC values belong here — anything starting with VITE_ ends up in the browser.
# Secret keys (service_role / secret key, Telegram bot token, Turnstile secret)
# go ONLY into Supabase Edge Function secrets, never into this file.

# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dev seed only (npm run db:seed) — emails of the two users you created in
# Supabase → Authentication → Users. Kept out of git on purpose.
SEED_OWNER_EMAIL=
SEED_BARBER_EMAIL=

# Show "Parolni unutdingizmi?" (password reset). Keep false until custom SMTP + a domain
# are configured (M9) — Supabase's built-in email only reaches project team members.
VITE_PASSWORD_RESET_ENABLED=false
